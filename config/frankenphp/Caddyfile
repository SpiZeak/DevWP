# DevWP global Caddyfile — mounted read-only at /etc/frankenphp/Caddyfile.
# Per-site snippets live in Caddyfile.d/ (generated by DevWP from
# template-site.caddy); 00-placeholder.caddy keeps the import glob non-empty
# on fresh checkouts before the first site exists.
{
	# Local admin endpoint: the healthcheck and POST
	# /frankenphp/workers/restart (worker reloads) go through it.
	admin localhost:2019

	# Caddy state must not land in /data or /config (root-owned tmpfs in the
	# compose stack); /tmp is world-writable and disposable.
	storage file_system /tmp/caddy

	# PHP thread pool (classic requests + worker-mode threads share it).
	# The default is 2× the visible CPU count (32 here) — one thread per
	# logical core is plenty for dev traffic and halves idle overhead.
	# Remove this block to restore the default; total workers across sites
	# must stay below num_threads.
	frankenphp {
		num_threads 16
	}
}

import /etc/frankenphp/Caddyfile.d/*.caddy
